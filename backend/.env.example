# FastAPI Environment Variables

# Security
SECRET_KEY=dev_secret_key_change_me_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./data/route53.db

# CORS Configuration
# For production, set to specific origins: http://localhost:3001,etc.
ALLOWED_ORIGINS=*

# Environment
ENV=development
